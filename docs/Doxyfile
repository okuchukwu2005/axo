#=====================================================================
# Axo GUI Framework – Doxyfile (2025)
#=====================================================================

PROJECT_NAME            = "Axo GUI Framework"
PROJECT_BRIEF           = "Lightweight modular C GUI library"

# --- C Language Enforcement ---
OPTIMIZE_OUTPUT_FOR_C   = YES
EXTENSION_MAPPING       = h=C
TYPEDEF_HIDES_STRUCT    = NO
HIDE_SCOPE_NAMES        = YES
VERBATIM_HEADERS        = NO


#---------------------------------------------------------------------
# Input
#---------------------------------------------------------------------
INPUT                   = ../axo ./mainpage.md
USE_MDFILE_AS_MAINPAGE  = ./mainpage.md
FILE_PATTERNS           = *.c *.h *.md
RECURSIVE               = YES

#---------------------------------------------------------------------
# Output
#---------------------------------------------------------------------
GENERATE_HTML           = YES
GENERATE_XML            = NO
GENERATE_LATEX          = NO

HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES

MARKDOWN_SUPPORT        = YES

#---------------------------------------------------------------------
# Extraction & Speed Optimizations
#---------------------------------------------------------------------
EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
SOURCE_BROWSER          = NO
INLINE_SOURCES          = NO
REFERENCED_BY_RELATION  = NO
REFERENCES_RELATION     = NO

#---------------------------------------------------------------------
# Diagrams (dot)
#---------------------------------------------------------------------
HAVE_DOT = NO
CALL_GRAPH = NO
CALLER_GRAPH = NO
CLASS_DIAGRAMS = NO
COLLABORATION_GRAPH = NO
#---------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------
QUIET                   = NO
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES